# Firebase Authentication Web API Key (Firebase Console > Project settings > Web API Key)
FIREBASE_API_KEY=

# URL do Firebase Realtime Database, por exemplo: https://seu-projeto-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=

# Usuário cadastrado no Firebase Authentication com provedor Email/Senha habilitado
FIREBASE_EMAIL=
FIREBASE_PASSWORD=

# Diretório de candidatos relativo à raiz do projeto
CANDIDATES_DIR=output_candidatos

# Nó do Realtime Database que receberá os registros
FIREBASE_CANDIDATES_PATH=candidatos
